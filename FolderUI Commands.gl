function FolderUIClass.cmdDelete (selection:array of String) do
	if selection.length == 0 do
		return false
	end

	var result = UI.dialog("Permanently delete {files}? This operation cannot be undone.".format([
			files=if selection.length == 1 -> this.folder.Files[selection[0]].name
				else -> String(selection.length, "#,### files")
		]))
	if !result do
		return false
	end

	for fileID in selection do
		var fileDesc = this.folder.Files[fileID]
		if fileDesc do
			if fileDesc.acl.can("admin") do
				var result = Data.delete(fileID, [ noExceptions="true" ])
			else do
				this.folder.folderDS.removeAt(fileID)				
			end
		end
	end

	this.listCtrl.selection = this.listCtrl.selection.filter(fn(id)->!selection.find(id))
end

function FolderUIClass.cmdDeselectAll () do
	this.listCtrl.selection = null
end

function FolderUIClass.cmdDetails (fileID:String) do

	var imageCtrl = UI.create("image", [
		width="260px",
		height="260px",
		align="top center",
		placeholder="Click here to set icon."
	])

	function imageCtrl.onclick () do
		var newIcon = UIImageSelectorDialog()
		if newIcon do
			imageCtrl.data = newIcon
		end
	end

	var detailsCtrl = UI.create("text", [
		format="markdown",
	])

	var formCtrl = UI.create("form", [
		cols=2,
		content=[
			[	id="icon",		col=0,	control=imageCtrl	],
			[	id="name",		col=1,	type=String,	label="Name"	],
			[	id="details",	col=1,	control=detailsCtrl ],
		]
	])

	//	Set current info

	var props = Data.getProperties(fileID)
	formCtrl.data = [
		icon=props.icon,
		name=props.name,
		details=
			"""
			**Type**: {type}   
			**Size**: {size:#,###}   
			**Owner**: {owner}   
			**Created By**: {createdBy}   
			**Created On**: {createdOn:d mmm yyyy}   
			**Modified By**: {modifiedBy}   
			**Modified On**: {modifiedOn:d mmm yyyy}   
			""".format(props)
	]

	//	Show dialog

	var result = UI.dialog(formCtrl, [], [
		label=props.name,
		width="700px"
	])

	if result 
			&& (result.name != props.name || result.icon != props.icon) do
		Data.setProperties(fileID, [
			name=result.name || "(Untitled)",
			icon=result.icon
		])
	end
end

function FolderUIClass.cmdDownload (fileID:String) do
end

function FolderUIClass.cmdMoveToShelf (selection:array of String) do
	for fileID in selection do
		this.shelfDS.append(fileID)
		this.folder.folderDS.removeAt(fileID)
	end
end

function FolderUIClass.cmdOpen (fileID:String) do

	var fileInfo = this.folder.Files[fileID]
	var actions = ActionListClass(fileInfo.actions, fileInfo.acl)

	//	The actions field is an array of structures. Each structure describes one
	//	possible operation for the file.
	//
	//	We look for id="open", which gives us the default open behavior.

	var open = actions.findAction(ActionVerb.open)
	if open.exec == ActionImpl.nothing do
		//	For image type files, we launch the Image Viewer

		if fileInfo.type in ["image/jpeg", "image/png", "image/svg+xml"] do
			this.cmdOpenImage(this.curFolderID, fileID)

		//	Otherwise, no action

		else do
			UI.dialog("No default open action for this file.")
			return false
		end
	end

	this.execAction(fileID, open)

end

function FolderUIClass.cmdOpenFolder (fileID:String) do
	this.curFolderID = fileID
	this.realize()
end

function FolderUIClass.cmdOpenImage (folderID:String, imageID:String) do
	var imageProgramID = Data.resolvePath("/archive/programs/Image Viewer")
	var ID = gridIDtoFileID(imageProgramID)

	UI.navigate("/program.hexm?id=" + ID + "&file=" + gridIDtoFileID(folderID) + "#" + imageID)
end

function FolderUIClass.cmdRemove (selection:array of String) do

	if selection.length == 0 do
		return false

	else if selection.length == 1 do

		var fileID = selection[0]

		//	See if this is the only folder that we are in.

		var folderList = Data.getProperties(fileID).folders
		var moveToLimbo = folderList.length == 0 || (folderList.length == 1 && folderList[0].id == this.folder.ID)
	
		//	Message depends on whether we move to Limbo or not

		var confirm = if moveToLimbo ->
			"Remove {file} from {folder} and move to Limbo?"
		else ->
			"Remove {file} from {folder} folder?"

		var dlgMessage = confirm.format([
			file=this.folder.Files[fileID].name,
			folder=this.folder.Name,
		])
		if !UI.dialog(dlgMessage, null, [ title="Are You Sure?" ]) do
			return false
		end

		this.folder.folderDS.removeAt(fileID)

		if moveToLimbo do
			this.limboDS.append(fileID)
		end

		return true

	else do

		var dlgMessage = "Remove {count} files from {folder} folder?"
			.format([
				count=selection.length,
				folder=this.folder.Name
			])

		if !UI.dialog(dlgMessage, null, [ title="Are You Sure?" ]) do
			return false
		end

		for fileID in selection do

			//	See if we move to Limbo or not

			var folderList = Data.getProperties(fileID).folders
			var moveToLimbo = folderList.length == 0 || (folderList.length == 1 && folderList[0].id == this.folder.ID)

			this.folder.folderDS.removeAt(fileID)

			if moveToLimbo do
				this.limboDS.append(fileID)
			end
		end

		return true
	end
end

function FolderUIClass.cmdRemoveSelected (selection:array of String) do
	if this.cmdRemove(selection) do
		this.listCtrl.selection = null
	end
end

function FolderUIClass.cmdRename (fileID:String) do
	schema RenameSchema [
		var name:String as "Name"
	]

	var properties = Data.getProperties(fileID)
	var result:RenameSchema? = UI.dialog(RenameSchema, [ name=properties.name ], [ title="Rename" ])
	if !result do
		return false
	end

	Data.setProperties(fileID, [ name=result.name.cleaned() || "(Untitled)" ])
end

function FolderUIClass.cmdRun (fileID:String) do'

	var fileInfo = this.folder.Files[fileID]
	var actions = ActionListClass(fileInfo.actions, fileInfo.acl)
	var run = actions.findAction(ActionVerb.run)
	if run.exec == ActionImpl.nothing do
		UI.dialog("No run action for this file.")
		return false
	end

	this.execAction(fileID, run)

end

function FolderUIClass.cmdRunProgram (programID:String, paramID:String) do
	var ID = gridIDtoFileID(programID)

	if paramID do
		UI.navigate("/program.hexm?id=" + ID + "&file=" + gridIDtoFileID(paramID))
	else do
		UI.navigate("/program.hexm?id=" + ID)
	end
end

function FolderUIClass.cmdSelectAll () do
	this.listCtrl.selection = this.folder.FileList.map(fn(entry)->entry.id)
end

function FolderUIClass.cmdShare (fileID:String) do

	var fileInfo = this.folder.Files[fileID]

	var resultACL = UIEditACL(fileInfo.acl, fileInfo.name)
	if resultACL do
		Data.setProperties(fileID, [ acl=resultACL ])
	end
end