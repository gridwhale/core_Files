
function FolderUIClass.cmdAddFilesByID () do
	schema AddFileSchema [
		var id:String as "File ID"
	]

	var result:AddFileSchema? = UI.dialog(AddFileSchema, null, [ title="Add File to Folder" ])
	if !result || !result.id do
		return false
	end

	var fileID = result.id
	if fileID.startsWith("/") do
	else if fileID.startsWith("file/") do
		fileID = "/" + fileID
	else do
		fileID = "/file/" + fileID
	end

	var props = Data.getProperties(fileID, [ noExceptions=true ])
	if props.type == "error" do
		UI.dialog("ERROR: " + props.data)
		return false
	end

	this.folder.addFile(props.id)
end

function FolderUIClass.cmdAddToShelf (selection:array of String) do
	for fileID in selection do
		this.shelfDS.append(fileID)
	end
end

function FolderUIClass.cmdCopyLink (selection:array of String) do
	if selection.length == 1 do
		var fileID = selection[0]
		var fileInfo = this.folder.Files[fileID]

		UI.dialog(fileID, null, [ title=fileInfo.name ])
	else do
		var IDs = selection.joined(Char(10))
		UI.dialog(IDs, null, [ title=String(selection.length) + " Files" ])
	end
end

function FolderUIClass.cmdCreateFolder () do
	schema CreateFolderSchema [
		var name:String as "Folder Name"
	]

	var result:CreateFolderSchema? = UI.dialog(CreateFolderSchema, [ name="New Folder" ], [ title="Create Folder" ])
	if !result do
		return false
	end

	Data.create(this.folder.ID, result.name.cleaned() || "New Folder", "folder")
end

function FolderUIClass.cmdCreateNotebook () do

	schema CreateNotebookSchema [
		var name:String as "Notebook Name"
	]

	var result:CreateNotebookSchema? = UI.dialog(CreateNotebookSchema, [ name="New Notebook" ], [ title="Create Notebook" ])
	if !result do
		return false
	end

	var notebookName = result.name.cleaned() || "New Notebook"

	var notebookID:String = Code.call("/archive/programs/GridMan", "CreateFile", [ name=notebookName ])
	if !notebookID do
		return false
	end
	
	//	Add the notebook to the current folder

	this.folder.folderDS.append(notebookID)

	//	Launch the notebook

	this.cmdRunProgram("/archive/programs/GridMan", notebookID)
end

function FolderUIClass.cmdCreateProgram () do

	enum EnvironmentType [
		clang		as "C"
		gridLang 	as "GridLang"
	]

	schema CreateProgramSchema [
		var env:EnvironmentType as "Environment"
		var name:String as "Program Name"
	]

	var result:CreateProgramSchema? = UI.dialog(CreateProgramSchema, [ name="New Program", env=Environment.gridLang ], [ title="Create Program" ])
	if !result do
		return false
	end

	var programName = result.name.cleaned() || "New Program"

	//	Create based on the environment.

	var programDS = 
		if result.env == Environment.gridLang
			-> this.cmdCreateGridLangProgram(programName)
		else if result.env == Environment.clang
			-> this.cmdCreateCProgram(programName)
		else
			-> error("Unknown environment")

	//	Launch the IDE

	this.cmdRunProgram("/archive/programs/IDE", String(programDS.datasetID))
end

function FolderUIClass.cmdCreateWebSite () do

	schema CreateWebSiteSchema [
		var name:String as "Web Site Title"
	]

	var result:CreateWebSiteSchema? = UI.dialog(CreateWebSiteSchema, [ name="New Web Site" ], [ title="Create Web Site" ])
	if !result do
		return false
	end

	var siteName = result.name.cleaned() || "New Web Site"

	//	Start by creating the siteDef file. But we don't initialized it
	//	yet.

	var siteDS = Data.create(this.folder.ID, siteName, "data", [
		fileType="application/x-gridSite"
	])

	//	Create index.html

	var sourceDS = Data.create(siteDS.datasetID, "index.html", "text", [
		fileType="text/html"
	])

	sourceDS.setValue(
		"""
		<!DOCTYPE html>
		<html lang="en">
		<head>
			<meta charset="UTF-8">
			<meta name="viewport" content="width=device-width, initial-scale=1.0">
			<title>Minimal HTML</title>
		</head>
		<body>
			<h1>Hello, World!</h1>
		</body>
		</html>
		"""
	)

	//	Now that we have the source file, create the descriptor.

	siteDS.setValue([
		name=siteName,
	])

end

function FolderUIClass.cmdCreateCProgram (name:String) do

	//	Start by creating the programDef file. But we don't initialized it
	//	yet.

	var programDS = Data.create(this.folder.ID, name, "data", [
		fileType="application/x-gridProgram"
	])

	//	Create a simple source file and set it as a child of the program.

	var sourceDS = Data.create(programDS.datasetID, "main.c", "text", [
		fileType="text/x-csrc"
	])

	sourceDS.setValue(
		"""
		#include <stdio.h>

		int main(void) {
			printf("Hello, world!\n");
			return 42;
		}
		"""
	)

	//	Now that we have the source file, create the descriptor.

	programDS.setValue([
		environment="clang",
		name=name,
		uiType="consoleUI"

		sources=[
			[
				filePath=sourceDS.datasetID,
				name="main.c",
				type="text/x-csrc"
			]
		]
	])

	return programDS
end

function FolderUIClass.cmdCreateGridLangProgram (name:String) do

	var programDS = Data.create(this.folder.ID, name, "data", [
		fileType="application/x-gridProgram"
	])

	//	Create a simple source file and set it as a child of the program.

	var sourceDS = Data.create(programDS.datasetID, name, "text", [
		fileType="text/x-gridLang"
	])

	sourceDS.setValue(
		"""
		//	GridWhale Program

		print("Hello, World!")
		"""
	)

	//	Now that we have the source file, create the descriptor.

	programDS.setValue([
		environment="gridLang",
		name=name,
		uiType="consoleUI"

		sources=[
			[
				filePath=sourceDS.datasetID,
				name=name,
				type="text/x-gridLang"
			]
		]
	])

	return programDS
end

